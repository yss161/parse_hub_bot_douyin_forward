# ============================================================
# 转发链路服务配置样例
# 使用方法：复制为仓库根目录下的 .env 并按需修改
#   cp .env.example .env
# 所有项都有默认值，只有 DOUYIN_MAIN_ACCOUNT 建议填写。
# ============================================================

# ─────────────── 抖音端（小号/接收） ───────────────

# 监测哪个（些）大号：用于在私信会话列表中定位"大号 → 小号"的会话（包含匹配）
# ── 单会话 ── 只监测一个用户：填 DOUYIN_MAIN_ACCOUNT（下方）
# ── 多会话 ── 同时监测多个用户/大号：填 DOUYIN_MAIN_ACCOUNTS，多个昵称用英文/中文逗号分隔
# 留空时：优先选择有未读角标的会话，否则选第一条会话
# 注意：匹配到的会话会被【严格锁定】——只解析这些会话内的新转发，其他会话/群聊的分享会被忽略
# 说明：部署脚本（install_ubuntu.sh）会交互式询问"单会话/多会话"并自动写入；
#       运行中也可以不改这里：往 forwarder_data/agent_cmd.txt 写昵称即可免重启更换
DOUYIN_MAIN_ACCOUNT=

# 多会话示例：DOUYIN_MAIN_ACCOUNTS=小明,大红（多个昵称用逗号分隔；设置后优先于上一行）
# DOUYIN_MAIN_ACCOUNTS=

# 私信页地址（一般无需修改；如抖音改版可调整）
# DOUYIN_CHAT_URL=https://www.douyin.com/chat?isPopup=1

# 无头模式：服务器上保持 true；本机调试可设为 false 观察浏览器
# 【重要】首次扫码登录建议设为 false（有界面），原因见 README「常见问题 Q2」
DOUYIN_HEADLESS=true

# 扫码登录等待超时（秒）
DOUYIN_QR_TIMEOUT=300

# 轮询私信间隔（秒）——reload 模式的轮询间隔；probe 模式用 DOUYIN_PROBE_INTERVAL
DOUYIN_POLL_INTERVAL=20

# ─────────────── 检测模式（reload / probe） ───────────────
# 决定"怎么发现新转发"，两种模式效果一致（解析结果完全相同），差别在资源与延迟：
#
#   reload（现状，默认）
#     · 每轮 page.reload 整页刷新 + 点开监测会话取接口数据
#     · 实时性最好、最稳（每轮全量重同步，推送失效也能发现）
#     · 实测每轮约 250 个请求 / 30 秒，长期占用较高
#
#   probe（B 方案）
#     · DOM 探针（只读页面，0 请求）+ 定期强制取数（点会话触发接口）+ 自愈刷新
#     · 请求量约降 95%+；正常消息 ≤ 探针间隔发现，推送失效时 ≤ 强制取数间隔兜底
#     · 适合服务器配置低 / 想省资源 / 长期挂机的场景
#
# 运行中可免重启切换：往 forwarder_data/agent_cmd.txt 写 "mode probe" 或 "mode reload"
# （持久化到 state.json，优先于这里的 .env 值；"mode reset" 恢复本文件默认）
DOUYIN_DETECT_MODE=reload

# probe 模式：DOM 探针间隔（秒）——只读一次页面，不发网络请求
DOUYIN_PROBE_INTERVAL=10

# probe 模式：强制取数间隔（秒）——无论页面有没有变化都点一次会话，防止推送静默失效
DOUYIN_FORCE_FETCH_INTERVAL=45

# probe 模式：自愈刷新间隔（秒）——定期整页 reload 重置页面状态；0 = 关闭
DOUYIN_RELOAD_INTERVAL=7200

# probe 模式：连续取数失败多少次后触发自愈刷新
DOUYIN_RELOAD_ON_FAILURES=3

# ─────────────── 实况图（Live Photo） ───────────────
# 只对「解析结果为实况图」的作品生效；普通视频/图集不受影响。
#
#   video（现状，默认）
#     · 只发视频，最稳、聊天最干净（实况图会变成普通视频）
#     · 丢失静态图/实况效果
#
#   live（只发实况图）
#     · 聊天里显示为实况图（静态图 + 动态）
#     · 旧客户端只显示静态图；没有视频备份；多图会逐条发送
#     · 视频超过 Telegram 限制（10 秒 / 10MB）时自动改发视频
#
#   both（实况图 + 视频）
#     · 实况图和视频都保留，兼容性最好
#     · 每条实况图会多发一条视频；流量/存储约翻倍
#     · 超限的只发视频；实况图超过 FORWARDER_LIVE_PHOTO_MAX_ITEMS 张时整帖回退视频
#
# 运行中可免重启切换：往 forwarder_data/agent_cmd.txt 写 "live video" / "live live" / "live both"
# （持久化到 state.json，优先于这里的 .env 值；"live reset" 恢复本文件默认）
FORWARDER_LIVE_PHOTO_MODE=video

# Telegram 硬限制：实况视频 ≤10 秒、≤10MB；超过则直接改发视频（不转码）
FORWARDER_LIVE_PHOTO_MAX_SECONDS=10
FORWARDER_LIVE_PHOTO_MAX_MB=10

# 实况图数量超过该值时，整帖回退为视频（避免逐条发送刷屏）；0 = 不限制
FORWARDER_LIVE_PHOTO_MAX_ITEMS=3

# 每轮轮询最多点击几张视频卡片（提取链接用）
DOUYIN_MAX_CLICKS=3

# 只处理"对方（大号）"发来的消息
DOUYIN_ONLY_OTHERS=true

# 首次运行时是否处理会话中的历史消息（默认 false：只处理服务启动后新转发的）
# 注意：修改为 true 前需先删除 forwarder_data/state.json 再重启
DOUYIN_PROCESS_HISTORY=false

# 可选：指定 Chromium/Chrome 可执行文件路径（默认使用 playwright 自带的 chromium）
# DOUYIN_CHROMIUM_PATH=/usr/bin/chromium

# ─────────────── 推送到 Telegram 群组/频道（可选） ───────────────
# 开启后：解析完成的媒体会自动发送到指定群组/频道（默认关闭，仅本地归档）

# 开关
TG_PUSH=false

# 目标：公开频道/群组用 @用户名；私有频道/群用 -100 开头的数字 ID；也支持 t.me 链接
TG_TARGET_CHAT=

# Telegram 凭据（留空时 TG 推送不可用；详细申请步骤见 README「推送到 Telegram 群组/频道」章节）
#   API_ID / API_HASH：在 https://my.telegram.org 创建应用获得
#   BOT_TOKEN：Telegram 中向 @BotFather 创建机器人获得
# API_ID=
# API_HASH=
# BOT_TOKEN=

# 国内服务器访问 Telegram 需要代理时填写（如 http://127.0.0.1:7890；海外服务器一般不需要）
# BOT_PROXY=

# ─────────────── 登录预览链接服务（截图/二维码变成可点击链接） ───────────────
# 把登录二维码、页面预览、菜单变成 http://<IP>:端口/文件名 形式的链接写进日志
# （只读服务，仅暴露白名单截图/菜单文件，不含登录态；0 = 关闭，日志退回本地文件路径）
FORWARDER_SHOT_PORT=8765

# 监听地址（一般不用改；只允许本机/SSH 隧道访问可设 127.0.0.1）
# FORWARDER_SHOT_BIND=0.0.0.0

# 链接里显示的对外 IP（留空 = 自动探测公网 IP；AWS 等 NAT 实例建议显式指定公网 IP）
# FORWARDER_SHOT_HOST=

# ─────────────── 本地缓存清理 ───────────────
# 推送成功后自动删除本地归档目录（仅当 TG 推送成功时执行）
FORWARDER_CLEANUP_AFTER_PUSH=true

# 缓存保留时长（小时）：定时清理 output/ 归档、debug/ 转储、downloads/ 残留；0 = 关闭
FORWARDER_CACHE_TTL_HOURS=72

# ─────────────── 解析 / 归档 ───────────────

# 解析结果输出目录（相对仓库根目录或绝对路径）
FORWARDER_OUTPUT_DIR=./output

# 两个视频解析之间的最小间隔（秒），避免请求过于频繁触发风控
FORWARDER_PARSE_MIN_INTERVAL=8

# 跳过原项目的媒体处理（转码/长图切割），直接归档原始文件（推荐）
# 设为 false 时走原项目处理（输出与原项目一致；服务器需安装 ffmpeg：apt install ffmpeg）
FORWARDER_SKIP_MEDIA_PROCESSING=true

# 在归档目录写入 metadata.json
FORWARDER_SAVE_METADATA=true

# 每次服务启动（小号登录成功后）自动把小号登录态 cookie 同步到解析端
# （解析端与接收端是两条独立通道；开启后手动填的 cookie 过期也不影响）
# 手动同步一次：python run.py export-cookie
FORWARDER_AUTO_SYNC_COOKIE=false

# ─────────────── 调试 ───────────────

# 调试日志
FORWARDER_DEBUG=false

# 提取失败时把私信页 HTML 转储到 forwarder_data/debug/（排查选择器用）
FORWARDER_DUMP_HTML=false
