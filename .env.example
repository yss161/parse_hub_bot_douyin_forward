# ============================================================
# 转发链路服务配置样例
# 使用方法：复制为仓库根目录下的 .env 并按需修改
#   cp .env.example .env
# 所有项都有默认值，只有 DOUYIN_MAIN_ACCOUNT 建议填写。
# ============================================================

# ─────────────── 抖音端（小号/接收） ───────────────

# 大号昵称关键字：用于在私信会话列表中定位"大号 → 小号"的会话（包含匹配）
# 留空时：优先选择有未读角标的会话，否则选第一条会话
DOUYIN_MAIN_ACCOUNT=

# 私信页地址（一般无需修改；如抖音改版可调整）
# DOUYIN_CHAT_URL=https://www.douyin.com/chat?isPopup=1

# 无头模式：服务器上保持 true；本机调试可设为 false 观察浏览器
# 【重要】首次扫码登录建议设为 false（有界面），原因见 README「常见问题 Q2」
DOUYIN_HEADLESS=true

# 扫码登录等待超时（秒）
DOUYIN_QR_TIMEOUT=300

# 轮询私信间隔（秒）
DOUYIN_POLL_INTERVAL=20

# 每轮轮询最多点击几张视频卡片（提取链接用）
DOUYIN_MAX_CLICKS=3

# 只处理"对方（大号）"发来的消息
DOUYIN_ONLY_OTHERS=true

# 首次运行时是否处理会话中的历史消息（默认 false：只处理服务启动后新转发的）
# 注意：修改为 true 前需先删除 forwarder_data/state.json 再重启
DOUYIN_PROCESS_HISTORY=false

# 可选：指定 Chromium/Chrome 可执行文件路径（默认使用 playwright 自带的 chromium）
# DOUYIN_CHROMIUM_PATH=/usr/bin/chromium

# ─────────────── 推送到 Telegram 群组/频道（可选） ───────────────
# 开启后：解析完成的媒体会自动发送到指定群组/频道（默认关闭，仅本地归档）

# 开关
TG_PUSH=false

# 目标：公开频道/群组用 @用户名；私有频道/群用 -100 开头的数字 ID；也支持 t.me 链接
TG_TARGET_CHAT=

# Telegram 凭据（留空时 TG 推送不可用；详细申请步骤见 README「推送到 Telegram 群组/频道」章节）
#   API_ID / API_HASH：在 https://my.telegram.org 创建应用获得
#   BOT_TOKEN：Telegram 中向 @BotFather 创建机器人获得
# API_ID=
# API_HASH=
# BOT_TOKEN=

# 国内服务器访问 Telegram 需要代理时填写（如 http://127.0.0.1:7890；海外服务器一般不需要）
# BOT_PROXY=

# ─────────────── 解析 / 归档 ───────────────

# 解析结果输出目录（相对仓库根目录或绝对路径）
FORWARDER_OUTPUT_DIR=./output

# 两个视频解析之间的最小间隔（秒），避免请求过于频繁触发风控
FORWARDER_PARSE_MIN_INTERVAL=8

# 跳过原项目的媒体处理（转码/长图切割），直接归档原始文件（推荐）
# 设为 false 时走原项目处理（输出与原项目一致；服务器需安装 ffmpeg：apt install ffmpeg）
FORWARDER_SKIP_MEDIA_PROCESSING=true

# 在归档目录写入 metadata.json
FORWARDER_SAVE_METADATA=true

# ─────────────── 调试 ───────────────

# 调试日志
FORWARDER_DEBUG=false

# 提取失败时把私信页 HTML 转储到 forwarder_data/debug/（排查选择器用）
FORWARDER_DUMP_HTML=false
